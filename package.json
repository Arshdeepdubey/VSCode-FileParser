{
  "name": "fileparse",
  "displayName": "file-parser",
  "description": "parse file in common industry wide format",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:fileparse.parser"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "fileparse.parser",
        "displayName": "File Parser",
        "selector": [
          {
            "filenamePattern": "*.{txt,csv}"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "fileparse.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "fileparse.exportJSON",
        "title": "Export as JSON"
      },
      {
        "command": "fileparse.copyToClipboard",
        "title": "Copy to Clipboard"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "csv-parser": "^3.0.0",
    "highlight.js": "^11.9.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/csv-parser": "^1.3.5",
    "@types/uuid": "^10.0.0",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
